# パンティアの環境変数の見本。値は入れない（鍵は Vercel の Environment Variables と手元の .env.local だけに置く）。
# 手元: このファイルを .env.local に写して値を入れる。.env.local は git にも Vercel にも上がらない（.gitignore・.vercelignore）。
# 未設定のまま使うと、その場で「環境変数 X が未設定です」で止まる（予備値で素通りさせない。lib/env.ts）。

# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
# ブラウザに配られる鍵（anon）。RLS が効く
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバーだけ。RLS を通らない鍵。NEXT_PUBLIC_ を付けない
SUPABASE_SERVICE_ROLE_KEY=

# ── サイト ────────────────────────────────────────────────
# 末尾の / なし。決済から戻る先・メールのリンクに使う（例: https://pantia.example.com）
NEXT_PUBLIC_SITE_URL=
# 外部アカウントでのログイン（カンマ区切り。google,x）。Supabase Auth 側で有効にしてから足す。空なら出さない
NEXT_PUBLIC_OAUTH_PROVIDERS=
# CSP を強制にするとき 1。最初は空（report-only）で出し、本番で違反0件を確かめてから 1 にする
CSP_ENFORCE=

# ── 定期実行（Vercel Cron） ───────────────────────────────
# 32文字以上のランダムな文字列。Vercel が Authorization: Bearer <値> を付けて /api/cron/* を呼ぶ
CRON_SECRET=

# ── 決済 ──────────────────────────────────────────────────
# mock = 試験用のテスト決済（本番＝VERCEL_ENV=production では購入を受け付けない）／live = Stripe・PayPay につなぐ
PAYMENT_MODE=mock
# 使える支払い方法（カンマ区切り。card,bank,paypay）。契約が下りない方法は外す
PAYMENT_METHODS=card,bank,paypay
STRIPE_SECRET_KEY=
# Stripe の Webhook（/api/webhooks/stripe）の署名の鍵
STRIPE_WEBHOOK_SECRET=
PAYPAY_API_KEY=
PAYPAY_API_SECRET=
PAYPAY_MERCHANT_ID=
# PayPay の本番につなぐとき 1。空なら試験環境（sandbox）
PAYPAY_PRODUCTION=

# ── メール ────────────────────────────────────────────────
# mock = 送らずに控えだけ残す（管理画面に警告が出る）／live = SendGrid で送る
MAIL_MODE=mock
SENDGRID_API_KEY=
# 送り主（SendGrid で認証済みのドメインのアドレス）
MAIL_FROM=
# お問い合わせの届け先。空ならお問い合わせを受け付けない
CONTACT_TO=

# ── 本人確認 ──────────────────────────────────────────────
# manual = 書類の写真を受け取り、管理画面で運営が見る／trustdock = TRUSTDOCK に回す
KYC_MODE=manual
TRUSTDOCK_API_BASE=
TRUSTDOCK_API_TOKEN=
# TRUSTDOCK の通知（/api/webhooks/kyc）の署名の鍵
TRUSTDOCK_WEBHOOK_SECRET=
